{
  "name": "pashurakshak",
  "version": "1.0.0",
  "description": "PashuRakshak – From Farmer Reports to Early-Warning Action",
  "scripts": {
    "server": "npm --prefix server run start",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client run build"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
